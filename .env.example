BOT_TOKEN=
TINVEST_TOKEN=
OWNER_CHAT_ID=
TINVEST_ACCOUNT_ID=
TARGET_FILE=./target.yaml
LOG_LEVEL=INFO

# Optional. Route only Telegram API traffic through a proxy (T-Invest goes direct).
# Useful when the server's IP can't reach api.telegram.org directly.
#
# Supported schemes: http, https, socks4, socks5.
# SOCKS5 resolves DNS via the proxy.
#
# If the proxy is bound to 127.0.0.1 on the Docker host, e.g. local Xray/sing-box:
#   TELEGRAM_PROXY_URL=socks5://127.0.0.1:10808
# then enable host networking:
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
# IPv6 hosts MUST be wrapped in square brackets:
#   TELEGRAM_PROXY_URL=socks5://user:pass@[2001:db8::1]:1080
#
# Other examples:
#   TELEGRAM_PROXY_URL=socks5://user:pass@1.2.3.4:1080
#   TELEGRAM_PROXY_URL=http://user:pass@proxy.example.com:3128
TELEGRAM_PROXY_URL=

# Required when T-Invest endpoint serves a certificate chain rooted at
# Russian Trusted Root CA. Must point to the CA bundle inside the container.
#
# The Docker image must include Russian Trusted Root CA and run update-ca-certificates.
# gRPC uses this bundle via GRPC_DEFAULT_SSL_ROOTS_FILE_PATH.
GRPC_DEFAULT_SSL_ROOTS_FILE_PATH=/etc/ssl/certs/ca-certificates.crt
